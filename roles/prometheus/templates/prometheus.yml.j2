global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['192.168.56.16:9093']

rule_files:
  - '/etc/prometheus/alert_rules.yml'

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - '{{ host }}:9100'
{% endfor %}

  - job_name: 'cadvisor'
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - '{{ host }}:8081'
{% endfor %}

  - job_name: 'app'
    static_configs:
      - targets:
{% for host in groups['appserver'] %}
          - '{{ host }}:3000'
{% endfor %}

  - job_name: 'elasticsearch'
    static_configs:
      - targets: ['192.168.56.16:9114']