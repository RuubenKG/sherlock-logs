FROM nginx:alpine
COPY index.html /usr/share/nginx/html/index.html
COPY intermission.png /usr/share/nginx/html/intermission.png
COPY Intermission.mp3 /usr/share/nginx/html/Intermission.mp3
COPY DooM.ttf /usr/share/nginx/html/DooM.ttf
COPY style.css /usr/share/nginx/html/style.css
COPY app.js /usr/share/nginx/html/app.js
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80